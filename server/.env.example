NODE_ENV=production
# Hosting-provided port. PORT has priority over SERVER_PORT.
PORT=3000
# Full-site hosting: the same Node process serves client and WebSocket.
STATIC_DIR=../client/dist
# On Enzonic set your exact public HTTPS URL; Render supplies RENDER_EXTERNAL_URL.
PUBLIC_URL=https://YOUR-PUBLIC-HOSTNAME
# Optional override for split hosting or additional exact browser origins (no paths/trailing /).
# ALLOWED_ORIGINS=https://PROJECT.pages.dev
