NODE_ENV=production
# Hosting-provided port. PORT has priority over SERVER_PORT.
PORT=3000
# Full-site hosting: the same Node process serves client and WebSocket.
STATIC_DIR=../client/dist
# Render supplies the trusted RENDER_EXTERNAL_URL automatically.
# PUBLIC_URL is not needed on Render.
# Optional exact browser origin override (no paths/trailing slash):
# ALLOWED_ORIGINS=https://tank-front.onrender.com
